# Base URL of the deployed FastAPI backend (no trailing slash).
# Local dev: leave unset to use the http://127.0.0.1:8000 fallback in code,
# or copy this file to .env and point it at your backend.
# On Vercel: set VITE_API_URL in the project's Environment Variables to your
# Railway backend URL, e.g. https://novac-backend.up.railway.app
VITE_API_URL=http://127.0.0.1:8000
